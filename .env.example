# ============================================================
# farmer-rag configuration
# Copy to `.env` and adjust.
#
# Local development assumes llama.cpp servers (OpenAI-compatible),
# one llama-server instance per role:
#   LLM:        llama-server -m <chat-model>.gguf --port 8080
#   Embeddings: llama-server -m <embedding-model>.gguf --embeddings --port 8081
#   Reranker:   llama-server -m <reranker-model>.gguf --rerank --port 8082
# ============================================================

# --- Chat LLM -----------------------------------------------
# Provider switch: local | openai | groq
#   local  = any OpenAI-compatible server (llama.cpp llama-server, vLLM, ...)
#   openai = api.openai.com          (e.g. LLM_MODEL=gpt-4o)
#   groq   = api.groq.com            (e.g. LLM_MODEL=openai/gpt-oss-120b)
# llama.cpp serves whichever model it was launched with; the model name here is
# informational for `local`.
LLM_PROVIDER=local
LLM_MODEL=qwen3-8b
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=local
LLM_TEMPERATURE=0.1
# Local/reasoning models on a single-slot server can take minutes on a cold
# first call — keep the timeout generous and retries low (an aborted request
# keeps the server busy while the retry queues behind it).
LLM_TIMEOUT=300
LLM_MAX_RETRIES=1
# Token streaming needs a gateway whose SSE reliably terminates. If answers
# hang while the model server sits idle, set this to false (answers then
# arrive in one piece; live pipeline status still shows).
LLM_STREAMING=true

# --- Embeddings ---------------------------------------------
# Provider switch: local | openai   (Groq has no embeddings API)
# The model name is recorded in the index manifest to detect embedder changes —
# keep it matching the GGUF you actually serve.
# NOTE: changing the embedding provider/model requires re-ingestion
# (`farmer-rag ingest <pdf> --force`).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_BASE_URL=http://localhost:8081/v1
EMBEDDING_API_KEY=local

# --- Reranker (HTTP /v1/rerank endpoint, e.g. llama.cpp --rerank) ---
RERANKER_ENABLED=true
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_BASE_URL=http://localhost:8082/v1
RERANKER_API_KEY=local
# Rerank servers cap tokens per query+document pair (llama.cpp: physical batch
# size, often 512); documents are truncated to this many chars before sending.
RERANK_MAX_DOC_CHARS=600

# --- Ingestion ----------------------------------------------
CONTEXTUALIZE_CHUNKS=false      # LLM blurb per chunk; slow on local models
CHILD_CHUNK_TOKENS=250
PARENT_CHUNK_TOKENS=1000

# --- Retrieval ----------------------------------------------
DENSE_TOP_K=12
SPARSE_TOP_K=12
RRF_K=60
RERANK_CANDIDATES=30
TOP_PARENTS=6
MAX_QUERY_VARIANTS=3

# --- Corrective loop ----------------------------------------
GRADING_ENABLED=true
MAX_RETRIEVAL_RETRIES=1

# --- Storage / misc -----------------------------------------
DATA_DIR=data
LOG_LEVEL=INFO

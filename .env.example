# ============================================================
# farmer-rag configuration
# Copy to `.env` and adjust. Defaults target local development
# with Ollama (ollama pull qwen3:8b qwen3-embedding:0.6b).
# ============================================================

# --- Chat LLM -----------------------------------------------
# Provider switch: local | openai | groq
#   local  = any OpenAI-compatible server (Ollama /v1, LM Studio, vLLM)
#   openai = api.openai.com          (e.g. LLM_MODEL=gpt-4o)
#   groq   = api.groq.com            (e.g. LLM_MODEL=openai/gpt-oss-120b)
LLM_PROVIDER=local
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120

# --- Embeddings ---------------------------------------------
# Provider switch: local | openai   (Groq has no embeddings API)
# NOTE: changing the embedding provider/model requires re-ingestion
# (`farmer-rag ingest <pdf> --force`).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama

# --- Reranker (runs in-process; downloads from Hugging Face once) ---
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto            # auto | mps | cuda | cpu

# --- Ingestion ----------------------------------------------
CONTEXTUALIZE_CHUNKS=false      # LLM blurb per chunk; slow on local models
CHILD_CHUNK_TOKENS=250
PARENT_CHUNK_TOKENS=1000

# --- Retrieval ----------------------------------------------
DENSE_TOP_K=12
SPARSE_TOP_K=12
RRF_K=60
RERANK_CANDIDATES=30
TOP_PARENTS=6
MAX_QUERY_VARIANTS=3

# --- Corrective loop ----------------------------------------
GRADING_ENABLED=true
MAX_RETRIEVAL_RETRIES=1

# --- Storage / misc -----------------------------------------
DATA_DIR=data
LOG_LEVEL=INFO
